APP_NAME="Product Catalogue API"
APP_ENV=local
# Generated on first container start (see docker/entrypoint.sh) or with `php artisan key:generate`.
APP_KEY=
# Keep false outside local debugging: debug pages leak config and stack traces.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Stateless JSON API: no sessions or database are needed.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Catalogue -------------------------------------------------------------
CATALOGUE_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_SECONDS=3
FAKESTORE_CACHE_TTL_SECONDS=600

# The products chosen as "top rated" for the home page, in display order.
FEATURED_PRODUCT_IDS=3,5,11,12,18
# How many highest-rated products to highlight at the top of each category page.
CATEGORY_TOP_RATED_COUNT=3
CATALOGUE_CURRENCY=USD

# Used to build product links inside enquiry emails.
STOREFRONT_URL=http://localhost:8080

# Browser origins allowed to call the API cross-origin (comma-separated).
# Empty by default: the web app is served from the same origin as the API.
CORS_ALLOWED_ORIGINS=

# --- Enquiry email ---------------------------------------------------------
SALES_INBOX_ADDRESS=sales@example.com
SALES_INBOX_NAME="Sales"

# Locally, mail goes to Mailpit (http://localhost:8025). To switch provider,
# change MAIL_MAILER (e.g. ses, postmark) and its credentials; no code changes.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@catalogue.example.com"
MAIL_FROM_NAME="Product Catalogue"

# Only needed if MAIL_MAILER=ses.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
